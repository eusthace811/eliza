{
	auto_https off
}

:8080 {
    log {
        output stdout
		level debug
    }

    reverse_proxy /agents/* 0.0.0.0:3000 {
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }

    reverse_proxy /client/* 0.0.0.0:5173 {
		rewrite /client/* /{path}
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }
}
