{
    debug
    log
    http_port 8080
    auto_https off
}

:8080 {
    log {
        output stdout
        format json
        level info
    }

    handle_path /api/* {
        reverse_proxy 0.0.0.0:3000 {
            retry 10
            health_timeout 5s
        }
    }

    handle_path /client/* {
        reverse_proxy 0.0.0.0:5173 {
            retry 10
            health_timeout 5s
        }
    }

    handle /* {
        reverse_proxy 0.0.0.0:5173 {
            retry 10
            health_timeout 5s
        }
    }
}
