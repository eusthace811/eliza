:8080 {
    log {
        output stdout
        format json
        level info
    }

    reverse_proxy /api/* 127.0.0.1:3000 {
		rewrite /api/* /{path}
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }

    reverse_proxy /client/* 127.0.0.1:5173 {
		rewrite /client/* /{path}
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }
}
