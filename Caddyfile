{
	auto_https off
}

:8080 {
	log {
		output stdout
		level debug
	}

	reverse_proxy localhost:3000 {
		lb_retries 3
		health_uri /
		health_interval 5s
		health_timeout 1m
		health_status 2xx
	}

	handle /client/* {
		root * /app/client/dist # Serve built frontend
		file_server

		@static {
			path /client/assets/*
			path /client/*.js
			path /client/*.css
			path /client/*.ts
			path /client/*.tsx
		}

		try_files {path} /index.html
	}
}
