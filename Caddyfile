:8080 {
    log {
        output stdout
        format json
        level info
    }

    reverse_proxy /api/* localhost:3000 {
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }

    reverse_proxy /client/* localhost:5173 {
        lb_retries 3
        health_uri /
        health_interval 5s
        health_timeout 1m
        health_status 2xx
    }
}
