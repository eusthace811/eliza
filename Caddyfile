{
	auto_https off
}

:8080 {
	log {
		output stdout
		level debug
	}

	reverse_proxy localhost:3000 {
		lb_retries 3
		health_uri /
		health_interval 5s
		health_timeout 1m
		health_status 2xx
	}

	handle /client/* {
		root * /app/client/dist
		file_server browse {
			mime_types {
				.js application/javascript
				.css text/css
				.png image/png
				.jpg image/jpeg
				.svg image/svg+xml
				.woff application/font-woff
				.woff2 application/font-woff2
				.ttf application/font-ttf
				.eot application/vnd.ms-fontobject
				.ico image/x-icon
				.html text/html
				.webmanifest application/json
			}
		}

		try_files {path} /index.html
	}
}
