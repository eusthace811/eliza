{
	auto_https off
}

:8080 {
	log {
		output stdout
		level debug
	}

	reverse_proxy localhost:3000 {
		lb_retries 3
		health_uri /
		health_interval 5s
		health_timeout 1m
		health_status 2xx
	}

	handle_path /client/* {
		rewrite * /{path.*}
		reverse_proxy localhost:5173 {
			lb_retries 3
			health_uri /
			health_interval 5s
			health_timeout 1m
			health_status 2xx
		}
	}
}
