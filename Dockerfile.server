# Use the pre-built Eliza image
FROM gcr.io/noid-one-development/noid-eliza:latest

# Set the working directory
WORKDIR /app

# Copy character JSON and environment variables
COPY characters/character.json /app/characters/character.json
COPY .env /app/.env
COPY entrypoint.sh /entrypoint.sh

# Expose port for Caddy proxy
EXPOSE 8080

# Run both the server and client concurrently
# CMD ["sh", "-c", "pnpm start --characters=characters/character.json & pnpm start:client & caddy run --config /etc/caddy/Caddyfile --adapter caddyfile"]
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]