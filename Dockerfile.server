# Use the pre-built Eliza image
FROM gcr.io/noid-one-development/noid-eliza:latest

# Set the working directory
WORKDIR /app

# Copy character JSON and environment variables
COPY characters/character.json /app/characters/character.json
COPY .env /app/.env

# Expose port 3000 for Google Cloud Run
EXPOSE 3000

# Run both the server and client concurrently
CMD ["sh", "-c", "pnpm start --characters=characters/character.json"]